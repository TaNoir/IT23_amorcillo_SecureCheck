@page
@model SecureCheck.Web.Pages.Computers.IndexModel
@{
    ViewData["Title"] = "Computers";
}

<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
        <h1 class="h3 mb-1 sc-heading"><i class="bi bi-pc-display me-2"></i>Computers</h1>
        <p class="text-muted small mb-0">Managed Windows computers eligible for remote security audits.</p>
    </div>
    @if (Model.CanManage)
    {
        <a asp-page="./Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add Computer
        </a>
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>@Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-octagon me-1"></i>@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card sc-card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label for="searchInput" class="form-label small fw-semibold">Search</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input id="searchInput" name="Search" value="@Model.Search" class="form-control"
                           placeholder="Name, IP / host name, or description..." />
                </div>
            </div>
            <div class="col-md-3">
                <label for="locationSelect" class="form-label small fw-semibold">Location</label>
                <select id="locationSelect" name="Location" class="form-select">
                    <option value="">All locations</option>
                    @foreach (var loc in Model.Locations)
                    {
                        <option value="@loc" selected="@(Model.Location == loc)">@loc</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label for="statusSelect" class="form-label small fw-semibold">Status</label>
                <select id="statusSelect" name="Status" class="form-select">
                    <option value="all" selected="@(Model.Status == "all")">All</option>
                    <option value="active" selected="@(Model.Status == "active")">Active only</option>
                    <option value="inactive" selected="@(Model.Status == "inactive")">Inactive only</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                <a asp-page="./Index" class="btn btn-outline-secondary" title="Reset filters">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card sc-card">
    <div class="card-body p-0">
        @if (Model.Computers.Count == 0)
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-pc-display fs-1 d-block mb-2"></i>
                <p class="mb-2">No computers match the current filters.</p>
                @if (Model.CanManage)
                {
                    <a asp-page="./Create" class="btn btn-sm btn-primary">
                        <i class="bi bi-plus-lg me-1"></i>Add Computer
                    </a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Name</th>
                            <th>Host / IP</th>
                            <th>Location</th>
                            <th>Credential</th>
                            <th>Last Audit</th>
                            <th>Status</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Computers)
                        {
                            var execMode = PowerShellRunner.DetermineMode(c.HostName);
                            <tr class="@(c.IsActive ? "" : "table-light text-muted")">
                                <td class="ps-3">
                                    <div class="fw-semibold">@c.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(c.Description))
                                    {
                                        <div class="small text-muted">@c.Description</div>
                                    }
                                </td>
                                <td><code>@c.HostName</code></td>
                                <td>@(string.IsNullOrWhiteSpace(c.Location) ? "—" : c.Location)</td>
                                <td>
                                    @if (execMode == ExecutionMode.Local)
                                    {
                                        <span class="text-muted small"><i class="bi bi-laptop me-1"></i>Local machine (no credential needed)</span>
                                    }
                                    else if (execMode == ExecutionMode.Demo)
                                    {
                                        <span class="text-muted small"><i class="bi bi-cpu me-1"></i>Simulated demo (no credential needed)</span>
                                    }
                                    else if (string.IsNullOrWhiteSpace(c.CredentialUserName))
                                    {
                                        <span class="text-muted small"><i class="bi bi-key me-1"></i>Uses default credential</span>
                                    }
                                    else
                                    {
                                        <span class="small"><i class="bi bi-person-lock me-1 text-sc-green"></i>@c.CredentialUserName</span>
                                    }
                                </td>
                                <td>
                                    @if (c.LastAuditedAt.HasValue)
                                    {
                                        <div class="small">@c.LastAuditedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                        <div>
                                            @if (c.LastScore.HasValue)
                                            {
                                                <span class="fw-semibold me-1">Score: @c.LastScore</span>
                                            }
                                            @if (c.LastRiskLevel.HasValue)
                                            {
                                                <span class="badge @c.LastRiskLevel.Value.ToBadgeClass()">@c.LastRiskLevel.Value</span>
                                            }
                                            else if (c.LastScore.HasValue)
                                            {
                                                <span class="badge risk-low">Secure</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Not audited</span>
                                    }
                                </td>
                                <td>
                                    @if (c.IsActive)
                                    {
                                        <span class="badge risk-low">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge status-error">Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                                        <a asp-page="./History" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-clock-history me-1"></i>History
                                        </a>
                                        @if (Model.CanAudit)
                                        {
                                            <form method="post" asp-page-handler="TestConnection" class="d-inline">
                                                <input type="hidden" name="id" value="@c.Id" />
                                                <input type="hidden" name="search" value="@Model.Search" />
                                                <input type="hidden" name="location" value="@Model.Location" />
                                                <input type="hidden" name="status" value="@Model.Status" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary"
                                                        data-loading-text="Testing...">
                                                    <i class="bi bi-plug me-1"></i>Test Connection
                                                </button>
                                            </form>
                                        }
                                        @if (Model.CanManage)
                                        {
                                            <a asp-page="./Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil me-1"></i>Edit
                                            </a>
                                            <form method="post" asp-page-handler="ToggleActive" class="d-inline">
                                                <input type="hidden" name="id" value="@c.Id" />
                                                <input type="hidden" name="search" value="@Model.Search" />
                                                <input type="hidden" name="location" value="@Model.Location" />
                                                <input type="hidden" name="status" value="@Model.Status" />
                                                @if (c.IsActive)
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                                            data-confirm="Deactivate @c.Name? Inactive computers will not appear in new audit runs.">
                                                        Deactivate
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                                        Activate
                                                    </button>
                                                }
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="card sc-card mx-auto" style="max-width: 640px;">
    <div class="card-body p-4 text-center">
        <i class="bi bi-exclamation-octagon text-danger display-5"></i>
        <h1 class="h4 sc-heading mt-3">Something went wrong</h1>
        <p class="text-muted">An error occurred while processing your request. Please try again.</p>
        @if (Model.ShowRequestId)
        {
            <p class="small text-muted mb-0">Request ID: <code>@Model.RequestId</code></p>
        }
        <a class="btn sc-btn-primary mt-3" href="~/">Back to Dashboard</a>
    </div>
</div>


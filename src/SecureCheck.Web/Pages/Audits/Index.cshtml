@page
@model SecureCheck.Web.Pages.Audits.IndexModel
@{
    ViewData["Title"] = "Audit History";
}

<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
    <div>
        <h1 class="h3 mb-1 sc-heading"><i class="bi bi-clock-history me-2"></i>Audit History</h1>
        <p class="text-muted small mb-0">
            Past and active security audit runs across managed Windows computers.
        </p>
    </div>
    @if (Model.CanAudit)
    {
        <a asp-page="./Run" class="btn btn-primary">
            <i class="bi bi-play-circle me-1"></i>Run Audit
        </a>
    }
</div>

<div class="card sc-card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-sm-6 col-md-4 col-lg-3">
                <label for="fromDate" class="form-label small fw-semibold">From Date</label>
                <input type="date" id="fromDate" name="From" value="@Model.FromInputValue" class="form-control" />
            </div>
            <div class="col-sm-6 col-md-4 col-lg-3">
                <label for="toDate" class="form-label small fw-semibold">To Date</label>
                <input type="date" id="toDate" name="To" value="@Model.ToInputValue" class="form-control" />
            </div>
            <div class="col-md-4 col-lg-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
                <a asp-page="./Index" class="btn btn-outline-secondary" title="Clear date filter">Reset</a>
            </div>
            <div class="col-lg-3 text-lg-end small text-muted">
                Showing @Model.Runs.Count of @Model.TotalCount @(Model.TotalCount == 1 ? "run" : "runs")
            </div>
        </form>
    </div>
</div>

<div class="card sc-card">
    <div class="card-body p-0">
        @if (Model.Runs.Count == 0)
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-clock-history fs-1 d-block mb-2"></i>
                @if (Model.From.HasValue || Model.To.HasValue)
                {
                    <p class="mb-3">No audit runs match the selected date range.</p>
                    <a asp-page="./Index" class="btn btn-sm btn-outline-secondary">Clear Filter</a>
                }
                else
                {
                    <p class="mb-3">No security audits have been run yet.</p>
                    @if (Model.CanAudit)
                    {
                        <a asp-page="./Run" class="btn btn-sm btn-primary">
                            <i class="bi bi-play-circle me-1"></i>Start First Audit
                        </a>
                    }
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Run</th>
                            <th>Date</th>
                            <th>Started By</th>
                            <th>Computers</th>
                            <th>Status</th>
                            <th>Average Score</th>
                            <th class="text-end pe-3">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var run in Model.Runs)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold">#@run.Id</td>
                                <td>
                                    <div>@AuditAnalyticsService.FormatLocalDateTime(run.CreatedAtUtc, "yyyy-MM-dd HH:mm:ss")</div>
                                    @if (run.StartedAtUtc.HasValue && run.FinishedAtUtc.HasValue)
                                    {
                                        var elapsed = Math.Max(0, (run.FinishedAtUtc.Value - run.StartedAtUtc.Value).TotalSeconds);
                                        <div class="small text-muted">Duration: @elapsed.ToString("F1")s</div>
                                    }
                                </td>
                                <td>@run.StartedByName</td>
                                <td>
                                    <span class="fw-semibold">@run.CompletedComputers / @run.TotalComputers</span>
                                    <span class="small text-muted">completed</span>
                                </td>
                                <td>
                                    <span class="badge @run.Status.ToBadgeClass()">
                                        @if (run.IsInProgress)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                        }
                                        @run.Status.ToDisplayName()
                                    </span>
                                </td>
                                <td>
                                    @if (run.AverageScore.HasValue)
                                    {
                                        <span class="fw-bold @run.AverageScoreTextClass me-1">@run.AverageScore.Value</span>
                                        <span class="badge @run.AverageScoreBadgeClass">@run.AverageScoreLabel</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">&mdash;</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    @if (run.IsInProgress)
                                    {
                                        <div class="d-inline-flex gap-1">
                                            <a asp-page="./Progress" asp-route-runId="@run.Id" class="btn btn-sm btn-primary">
                                                <i class="bi bi-activity me-1"></i>Live Progress
                                            </a>
                                            <a asp-page="./Details" asp-route-runId="@run.Id" class="btn btn-sm btn-outline-secondary">
                                                Details
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <a asp-page="./Details" asp-route-runId="@run.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-clipboard2-data me-1"></i>View Details
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="card-footer bg-white d-flex flex-wrap align-items-center justify-content-between gap-2 py-3">
                    <span class="small text-muted">
                        Page @Model.PageNumber of @Model.TotalPages (@Model.TotalCount total runs)
                    </span>
                    <nav aria-label="Audit history pagination">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-page="./Index"
                                   asp-route-PageNumber="@(Model.PageNumber - 1)"
                                   asp-route-From="@Model.FromInputValue"
                                   asp-route-To="@Model.ToInputValue">
                                    Previous
                                </a>
                            </li>
                            @{
                                var startPage = Math.Max(1, Model.PageNumber - 2);
                                var endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
                            }
                            @for (var p = startPage; p <= endPage; p++)
                            {
                                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                    <a class="page-link"
                                       asp-page="./Index"
                                       asp-route-PageNumber="@p"
                                       asp-route-From="@Model.FromInputValue"
                                       asp-route-To="@Model.ToInputValue">
                                        @p
                                    </a>
                                </li>
                            }
                            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-page="./Index"
                                   asp-route-PageNumber="@(Model.PageNumber + 1)"
                                   asp-route-From="@Model.FromInputValue"
                                   asp-route-To="@Model.ToInputValue">
                                    Next
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>


@page
@model SecureCheck.Web.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Manage Users";
}

<div class="mb-4">
    <h1 class="h3 mb-1 sc-heading"><i class="bi bi-people me-2"></i>User Management</h1>
    <p class="text-muted small mb-0">Create staff accounts, assign roles (Administrator, Auditor, Viewer), reset passwords, or deactivate access.</p>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>@Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-octagon me-1"></i>@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card sc-card mb-4">
    <div class="card-header py-3">
        <i class="bi bi-person-plus me-1"></i>Create New User
    </div>
    <div class="card-body">
        <form method="post" asp-page-handler="Create" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <div class="row g-3 align-items-start">
                <div class="col-md-3">
                    <label asp-for="Create.FullName" class="form-label small fw-semibold"></label>
                    <input asp-for="Create.FullName" class="form-control" placeholder="e.g. Juan Dela Cruz" />
                    <span asp-validation-for="Create.FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Create.Email" class="form-label small fw-semibold"></label>
                    <input asp-for="Create.Email" class="form-control" autocomplete="off" placeholder="e.g. auditor@securecheck.local" />
                    <span asp-validation-for="Create.Email" class="text-danger small"></span>
                </div>
                <div class="col-md-2">
                    <label asp-for="Create.Role" class="form-label small fw-semibold"></label>
                    <select asp-for="Create.Role" class="form-select">
                        @foreach (var r in AppRoles.All)
                        {
                            <option value="@r">@r</option>
                        }
                    </select>
                    <span asp-validation-for="Create.Role" class="text-danger small"></span>
                </div>
                <div class="col-md-2">
                    <label asp-for="Create.TempPassword" class="form-label small fw-semibold"></label>
                    <input asp-for="Create.TempPassword" type="password" value="" class="form-control"
                           autocomplete="new-password" placeholder="Min 8 chars, A-z, 0-9" />
                    <span asp-validation-for="Create.TempPassword" class="text-danger small"></span>
                </div>
                <div class="col-md-2 pt-md-4">
                    <button type="submit" class="btn btn-primary w-100 mt-md-1">
                        <i class="bi bi-plus-lg me-1"></i>Create User
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card sc-card">
    <div class="card-header py-3">
        <i class="bi bi-shield-lock me-1"></i>Accounts (@Model.Users.Count)
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Full Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Users)
                    {
                        var isSelf = u.Id == Model.CurrentUserId;
                        <tr class="@(u.IsActive ? "" : "table-light text-muted")">
                            <td class="ps-3 fw-semibold">
                                @u.FullName
                                @if (isSelf)
                                {
                                    <span class="badge sc-badge-navy ms-1">You</span>
                                }
                            </td>
                            <td>@u.Email</td>
                            <td style="min-width: 220px;">
                                @if (isSelf)
                                {
                                    <span class="badge sc-badge-navy">@u.Role</span>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="ChangeRole" class="d-flex gap-1 align-items-center">
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <select name="role" class="form-select form-select-sm" style="max-width: 150px;" aria-label="Role for @u.FullName">
                                            @foreach (var r in AppRoles.All)
                                            {
                                                <option value="@r" selected="@(u.Role == r)">@r</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                                    </form>
                                }
                            </td>
                            <td>
                                @if (!u.IsActive)
                                {
                                    <span class="badge status-error">Inactive</span>
                                }
                                else if (u.IsLockedOut)
                                {
                                    <span class="badge risk-high">Locked Out</span>
                                }
                                else
                                {
                                    <span class="badge risk-low">Active</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="d-inline-flex gap-1">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            data-bs-toggle="modal"
                                            data-bs-target="#resetPasswordModal"
                                            data-user-id="@u.Id"
                                            data-user-label="@u.FullName (@u.Email)">
                                        <i class="bi bi-key me-1"></i>Reset Password
                                    </button>

                                    @if (u.IsActive)
                                    {
                                        @if (isSelf)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled
                                                    title="You cannot deactivate your own account">
                                                Deactivate
                                            </button>
                                        }
                                        else
                                        {
                                            <form method="post" asp-page-handler="Deactivate" class="d-inline">
                                                <input type="hidden" name="userId" value="@u.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                                        data-confirm="Deactivate @u.FullName (@u.Email)? They will be signed out within a minute and cannot log in.">
                                                    Deactivate
                                                </button>
                                            </form>
                                        }
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="Activate" class="d-inline">
                                            <input type="hidden" name="userId" value="@u.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                Activate
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Reset Password Modal -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="ResetPassword" autocomplete="off">
                <div class="modal-header">
                    <h2 class="modal-title h5 sc-heading" id="resetPasswordModalLabel">
                        <i class="bi bi-key me-1"></i>Reset User Password
                    </h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="userId" id="resetUserId" />
                    <p class="small text-muted mb-3">
                        Setting a new temporary password for <strong id="resetUserLabel"></strong>.
                        Must be at least 8 characters and include uppercase, lowercase, and a digit.
                    </p>
                    <div>
                        <label for="resetNewPassword" class="form-label fw-semibold">New Temporary Password</label>
                        <input type="password" name="newPassword" id="resetNewPassword" value=""
                               class="form-control" required minlength="8" autocomplete="new-password" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Reset Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('resetPasswordModal')?.addEventListener('show.bs.modal', function (event) {
            const trigger = event.relatedTarget;
            if (!trigger) return;
            document.getElementById('resetUserId').value = trigger.getAttribute('data-user-id') || '';
            document.getElementById('resetUserLabel').textContent = trigger.getAttribute('data-user-label') || '';
            document.getElementById('resetNewPassword').value = '';
        });
    </script>
}


@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="sc-auth-wrapper">
    <div class="card sc-card sc-auth-card">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-4">
                <img src="~/img/logo.png" alt="SecureCheck logo" class="sc-auth-logo mb-2"
                     onerror="this.style.display='none';this.nextElementSibling.classList.remove('d-none');" />
                <i class="bi bi-shield-check display-4 sc-heading d-none" aria-hidden="true"></i>
                <h1 class="h4 sc-heading mb-1">SecureCheck</h1>
                <p class="text-muted small mb-0">Endpoint Security Audit Tool</p>
            </div>

            <form id="account" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email"></label>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.Password"></label>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label" asp-for="Input.RememberMe"></label>
                </div>

                <button id="login-submit" type="submit" class="w-100 btn btn-lg sc-btn-primary">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Log in
                </button>
            </form>

            <p class="text-muted small text-center mt-4 mb-0">
                Accounts are created by a System Administrator.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}

